PORT=3000

# ===== CSDL: MySQL trong XAMPP (mặc định user root, KHÔNG có mật khẩu) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=iot_device_manager

JWT_SECRET=doi_chuoi_bi_mat_nay_truoc_khi_chay
JWT_EXPIRES_IN=7d

# ===== MQTT: Broker Mosquitto chạy trên chính laptop (giống Bài 2) =====
MQTT_BROKER_URL=mqtt://localhost:1999
MQTT_USERNAME="Do Minh Quan"
MQTT_PASSWORD=MAT_KHAU_MQTT
MQTT_CLIENT_ID=iot-backend-server

# Sau bao nhiêu ms không nhận được status thì coi lệnh là timeout
ACTION_TIMEOUT_MS=5000

# UC07: ngưỡng nhiệt độ (°C) để hệ thống tự động bật Điều hòa + phát cảnh báo
TEMP_ALERT_THRESHOLD=32

# Chế độ demo: true = bật/tắt thiết bị luôn thành công, không cần board (giống chạy `npm run demo`)
DEMO_MODE=false
